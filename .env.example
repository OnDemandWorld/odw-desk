# ODW.ai Desk — Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=ODW.ai Desk
APP_VERSION=1.0.0
ENVIRONMENT=development  # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=DEBUG  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql+asyncpg://desk:desk@localhost:5432/desk
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# REDIS
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=desk:

# ============================================================================
# SECURITY
# ============================================================================
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me-in-production-must-be-64-chars
DEPLOYMENT_ID=dev-local-001

# ============================================================================
# EVENT BUS
# ============================================================================
EVENT_BUS_BACKEND=redis_streams  # redis_streams | nats

# ============================================================================
# VAULT (Knowledge Base)
# Real Vault API: POST /query on port 8765, no auth (Authorization header is
# ignored). VAULT_API_KEY is only sent if set to a real, non-default value.
# ============================================================================
VAULT_URL=http://localhost:8765
VAULT_API_KEY=vk_dev_local_key
VAULT_COLLECTION_ID=col-dev-001

# ============================================================================
# AUTHENTICATION (OIDC)
# ============================================================================
AUTH_OIDC_ISSUER=http://localhost:8080/realms/odw
AUTH_OIDC_CLIENT_ID=desk
AUTH_OIDC_AUDIENCE=desk-api

# ============================================================================
# WHATSAPP BUSINESS API (Meta/BSP)
# ============================================================================
# Leave empty for free tier or Baileys bridge mode
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ============================================================================
# WHATSAPP BAILEYS BRIDGE (Unofficial, quick-start)
# ============================================================================
BAILEYS_BRIDGE_URL=http://localhost:3001
BAILEYS_ENABLED=true

# ============================================================================
# EMAIL CHANNEL (V1.5 F-2)
# Disabled by default so dev never requires a live SMTP server; outbound
# replies are stubbed until EMAIL_ENABLED=true and a host is configured.
# ============================================================================
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=

# ============================================================================
# LOCAL MODEL (Ollama/vLLM)
# ============================================================================
OLLAMA_ENDPOINT=http://localhost:11434
LOCAL_MODEL_NAME=llama-3.1-8b
LOCAL_MODEL_ENABLED=true

# ============================================================================
# FRONTIER MODEL (OpenAI/Anthropic)
# ============================================================================
FRONTIER_PROVIDER=none  # none | openai | anthropic
FRONTIER_API_KEY=
FRONTIER_MODEL_NAME=gpt-4o-mini
FRONTIER_ENABLED=false

# ============================================================================
# AI CONFIGURATION
# ============================================================================
CONFIDENCE_THRESHOLD=0.6
PII_SHIELD_ENABLED=true
PII_FRONTIER_ALLOWED_WITH_REDACTION=false

# ============================================================================
# SLA CONFIGURATION
# ============================================================================
SLA_FIRST_RESPONSE_MINUTES=10
SLA_RESOLUTION_HOURS=48

# ============================================================================
# DATA RETENTION
# ============================================================================
DATA_RETENTION_DAYS=365

# ============================================================================
# LICENSE
# ============================================================================
LICENSE_KEY=free
LICENSE_GRACE_PERIOD_DAYS=7

# ============================================================================
# S3-COMPATIBLE OBJECT STORAGE (MinIO for dev)
# ============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=desk-dev
S3_REGION=us-east-1
S3_USE_SSL=false
